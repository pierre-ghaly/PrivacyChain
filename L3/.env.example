# L3 Encrypted Storage Service — environment variables
# Copy to .env and adjust for your setup.

# HTTP port this service listens on
L3_PORT=3002

# Base URL of the L2 Key Management Service
L2_URL=http://127.0.0.1:3001

# Directory where Helia stores IPFS blocks (persists across restarts)
L3_STORAGE_PATH=.data/ipfs

# L3's own (txId, dataType) -> CID index (better-sqlite3)
L3_CID_DB_PATH=.data/cids.db

# Shared secret required on every request except /health — rejects anything
# that isn't L2. Must match L2's L3_INTERNAL_KEY exactly.
# CHANGE THIS in any non-development context.
L3_INTERNAL_KEY=dev-only-l2-l3-shared-secret-change-in-production
