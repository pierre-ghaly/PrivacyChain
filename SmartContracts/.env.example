# Sepolia RPC (Infura, Alchemy, public RPC, etc.)
SEPOLIA_RPC_URL=

# Deployer wallet — fund this address with Sepolia ETH from a faucet
PRIVATE_KEY=

# Optional: https://etherscan.io/apis — for contract verification
ETHERSCAN_API_KEY=

# Optional: platform/system address passed to AssetRegistry.initialize (defaults to deployer)
# SYSTEM_ADDRESS=

# After first deploy, keep this for upgrades (proxy address never changes)
# PROXY_ADDRESS=
